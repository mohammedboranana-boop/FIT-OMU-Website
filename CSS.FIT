body{
    font-family: Arial, sans-serif;
    margin: 0;
    background: #f4f4f4;
    line-height: 1.8;
}

header{
    background: #003366;
    color: white;
    text-align: center;
    padding: 25px;
}

.container{
    width: 90%;
    max-width: 1000px;
    margin: auto;
    background: white;
    padding: 20px;
    margin-top: 20px;
    margin-bottom: 20px;
    border-radius: 10px;
}

h2{
    color: #003366;
    border-bottom: 2px solid #003366;
    padding-bottom: 5px;
}

table{
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
}

table, th, td{
    border: 1px solid #000;
}

th, td{
    padding: 10px;
    text-align: center;
}

footer{
    background: #003366;
    color: white;
    text-align: center;
    padding: 15px;
}
